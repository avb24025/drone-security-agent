# ─────────────────────────────────────────────
# Drone Security Agent – Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────

# Groq API key — used for both frame analysis and the AI chatbot
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq model
GROQ_MODEL=qwen/qwen3.8-27b

# SQLite database file path (relative to Backend/)
DATABASE_URL=sqlite:///./drone_security.db

# CORS origin for the React frontend
FRONTEND_ORIGIN=http://localhost:5173

# Restricted hours for loitering alert (24-hour format)
RESTRICTED_HOUR_START=22
RESTRICTED_HOUR_END=6

# Minimum frames before loitering alert fires
LOITERING_MIN_FRAMES=2

# Comma-separated list of authorized vehicle descriptions
AUTHORIZED_VEHICLES=blue Ford F150,white Toyota Camry

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
